# ============================================================================
#  Bot de turnos — Embajada de Austria (Buenos Aires)
#  Copiá este archivo a .env y completá los valores.
# ============================================================================

# --- Telegram (OBLIGATORIO) -------------------------------------------------
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll
# Tu chat id numérico (ver README, sección "Sacar el chat_id").
TELEGRAM_CHAT_ID=123456789

# --- Cada cuánto chequear ---------------------------------------------------
# En minutos. El mínimo permitido es 10 (para no castigar al servidor).
# Ojo: cada chequeo barre ~24 semanas = ~24 requests. Con 30 min son ~48 req/h.
CHECK_INTERVAL_MINUTES=30

# --- Rango de fechas que te interesa ----------------------------------------
# Formato YYYY-MM-DD. Si DATE_FROM se deja vacío, se usa "hoy".
DATE_FROM=
DATE_TO=2027-01-31

# --- Qué se vigila ----------------------------------------------------------
# CALENDAR_ID 11997661 = "Working Holiday Programm" en buenos-aires.
# (Verificado en julio 2026. Si la embajada lo cambia, el bot avisa y hace
#  fallback buscando por CALENDAR_LABEL.)
OFFICE=buenos-aires
CALENDAR_ID=11997661
CALENDAR_LABEL=Working Holiday Programm
PERSON_COUNT=1
BASE_URL=https://appointment.bmeia.gv.at

# --- Heartbeat diario -------------------------------------------------------
HEARTBEAT_ENABLED=true
HEARTBEAT_HOUR=9
TIMEZONE=America/Argentina/Buenos_Aires

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Archivos de estado -----------------------------------------------------
STATE_FILE=data/state.json
SCREENSHOT_DIR=data/screenshots

# --- Navegación / robustez --------------------------------------------------
HEADLESS=true
NAV_TIMEOUT_MS=45000
# Pausa entre acciones contra el servidor (segundos).
POLITE_DELAY_SECONDS=2
# Tope duro de semanas por corrida (cada semana = 1 request). El rango
# hoy → ene/2027 son ~24 semanas; 40 deja margen sin desbocarse.
MAX_WEEKS_TO_SCAN=40
MAX_FLOW_STEPS=8
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_FACTOR=3

# --- Alertas ----------------------------------------------------------------
# Cuántas corridas fallidas seguidas antes de avisar.
FAILURE_ALERT_THRESHOLD=3
# Minutos de silencio entre alertas repetidas del mismo tipo (anti-spam).
STRUCTURE_ALERT_COOLDOWN_MINUTES=180
# Mandar el screenshot por Telegram cuando algo falla.
SEND_SCREENSHOTS=true

# Opcional: user-agent del browser. Por defecto, un Chrome real reciente.
# USER_AGENT=
